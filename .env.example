# ---------------------------------------------------------------
# framegenjutsu configuration.  Copy to ".env" and fill in what you use.
# ---------------------------------------------------------------

# Web server port (the UI is served from the same port).
PORT=8787

# Bind address. 127.0.0.1 keeps the app local-only (recommended).
HOST=127.0.0.1

# Public base URL of this server, e.g. https://abc123.ngrok.app
# Some providers (Luma, Runway) can only take images that are reachable
# from the public internet. When this is empty those providers will be
# sent a base64 data URI instead, which only some of them accept.
PUBLIC_BASE_URL=

# Where generated scenes are written. Defaults to <repo>/projects
PROJECTS_DIR=

# ---------------------------------------------------------------
# Provider API keys - fill in only the ones you plan to use.
# ---------------------------------------------------------------

# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# https://fal.ai/dashboard/keys   (format: id:secret)
FAL_KEY=

# https://dev.runwayml.com/
RUNWAYML_API_SECRET=

# https://lumalabs.ai/dashboard/api-keys
LUMAAI_API_KEY=

# ---------------------------------------------------------------
# ffmpeg. A static ffmpeg/ffprobe ships with the npm install; set these
# only if you want to use your own build.
# ---------------------------------------------------------------
FFMPEG_PATH=
FFPROBE_PATH=

# Image normalisation: long edge cap for uploaded anchors.
# 0 = keep the original resolution (best quality, slower uploads to APIs).
MAX_EDGE=0

# Default playback frame rate used for the preview mp4/gif.
PREVIEW_FPS=12
